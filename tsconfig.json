{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "jest"]
  },
  "include": [
    "data-generator/**/*.ts",
    "matching-engine/**/*.ts",
    "ai/**/*.ts",
    "audit/**/*.ts",
    "reporting/**/*.ts",
    "server/**/*.ts",
    "demo.ts",
    "tests/**/*.ts"
  ]
}
