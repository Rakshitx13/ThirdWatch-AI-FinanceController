{
  "name": "ai-finance-controller",
  "version": "0.1.0",
  "private": true,
  "description": "ThirdWatch — deterministic and AI-assisted merchant ledger reconciliation with measured accuracy and a complete audit trail",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "generate": "tsc --project tsconfig.json && node dist/data-generator/index.js",
    "reconcile": "tsc --project tsconfig.json && node dist/reporting/runPipeline.js",
    "server": "tsc --project tsconfig.json && node dist/server/app.js",
    "client:dev": "vite --config client/vite.config.ts",
    "client:build": "tsc --project client/tsconfig.json && vite build --config client/vite.config.ts",
    "client:test": "vitest run --config client/vite.config.ts",
    "build": "tsc --project tsconfig.json && tsc --project client/tsconfig.json && vite build --config client/vite.config.ts",
    "demo": "pnpm run build && node dist/demo.js",
    "test:all": "pnpm test && pnpm run client:test",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project client/tsconfig.json --noEmit",
    "cleanup:data": "node scripts/cleanup-data.js --days 90 --dry-run",
    "validate:release": "node scripts/validate-release.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jest": "^29.7.0",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  }
}
